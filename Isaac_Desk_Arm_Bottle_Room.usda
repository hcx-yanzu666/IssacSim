                        }

                        over "Kitchen_Cabinet001_Door003_C002_Shape"
                        {
                            bool physics:collisionEnabled = 0
                        }
                    }
                }

                over "Kitchen_Cabinet001_Door004"
                {
                    bool physics:rigidBodyEnabled = 0

                    over "Kitchen_Cabinet001_Door004"
                    {
                        over "RevoluteJoint" (
                            active = false
                        )
                        {

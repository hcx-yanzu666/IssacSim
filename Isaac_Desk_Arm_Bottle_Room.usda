#usda 1.0
(
    customLayerData = {
        dictionary cameraSettings = {
            string boundCamera = "/World/Room/OverviewCamera"
        }
        string description = "Simple room decoration; original desk collider and task transforms preserved."
    }
    defaultPrim = "World"
    metersPerUnit = 1
    subLayers = [
        @./Isaac_Desk_Arm_Bottle.usda@
    ]
    upAxis = "Z"
)

over "World"
{
    def Xform "Room"
    {
        def "Looks"
        {
            def Material "WarmConcrete"
            {
                token outputs:surface.connect = </World/Room/Looks/WarmConcrete/Surface.outputs:surface>

                def Shader "Surface"
                {
                    uniform token info:id = "UsdPreviewSurface"
                    color3f inputs:diffuseColor = (0.28, 0.27, 0.24)
                    float inputs:roughness = 0.88
                    token outputs:surface
                }
            }

            def Material "WarmPlaster"
            {
                token outputs:surface.connect = </World/Room/Looks/WarmPlaster/Surface.outputs:surface>

                def Shader "Surface"
                {
                    uniform token info:id = "UsdPreviewSurface"
                    color3f inputs:diffuseColor = (0.62, 0.6, 0.54)
                    float inputs:roughness = 0.85
                    token outputs:surface
                }
            }

            def Material "SagePaint"
            {
                token outputs:surface.connect = </World/Room/Looks/SagePaint/Surface.outputs:surface>

                def Shader "Surface"
                {
                    uniform token info:id = "UsdPreviewSurface"
                    color3f inputs:diffuseColor = (0.2, 0.29, 0.27)
                    float inputs:roughness = 0.8
                    token outputs:surface
                }
            }

            def Material "DarkTrim"
            {
                token outputs:surface.connect = </World/Room/Looks/DarkTrim/Surface.outputs:surface>

                def Shader "Surface"
                {
                    uniform token info:id = "UsdPreviewSurface"
                    color3f inputs:diffuseColor = (0.065, 0.075, 0.07)
                    float inputs:roughness = 0.6
                    token outputs:surface
                }
            }
        }

        def Cube "Floor" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </World/Room/Looks/WarmConcrete>
            double size = 1
            float xformOp:rotateZ = 0
            float3 xformOp:scale = (6, 6, 0.06)
            double3 xformOp:translate = (0, 0, -0.035)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZ", "xformOp:scale"]
        }

        def Cube "BackWall" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </World/Room/Looks/WarmPlaster>
            double size = 1
            float xformOp:rotateZ = 0
            float3 xformOp:scale = (6, 0.12, 3.1)
            double3 xformOp:translate = (0, 2.55, 1.55)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZ", "xformOp:scale"]
        }

        def Cube "LeftWall" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </World/Room/Looks/SagePaint>
            double size = 1
            float xformOp:rotateZ = 0
            float3 xformOp:scale = (0.12, 5.1, 3.1)
            double3 xformOp:translate = (-2.55, 0, 1.55)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZ", "xformOp:scale"]
        }

        def Cube "BackSkirting" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </World/Room/Looks/DarkTrim>
            double size = 1
            float xformOp:rotateZ = 0
            float3 xformOp:scale = (5, 0.025, 0.12)
            double3 xformOp:translate = (0, 2.47, 0.06)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZ", "xformOp:scale"]
        }

        def Cube "LeftSkirting" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </World/Room/Looks/DarkTrim>
            double size = 1
            float xformOp:rotateZ = 0
            float3 xformOp:scale = (0.025, 5, 0.12)
            double3 xformOp:translate = (-2.47, 0, 0.06)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZ", "xformOp:scale"]
        }

        def Xform "Table"
        {
            float xformOp:rotateZ = 0
            float3 xformOp:scale = (0.8386774, 0.9403149, 1.0516825)
            double3 xformOp:translate = (-9.997814049371063e-8, 0, 0.005951619814327684)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZ", "xformOp:scale"]

            def "Model" (
                prepend references = @D:/tools/Lightwheel_OpenSource/Lightwheel_OpenSource/Locomotion/Apartment/Props/SM_table_02_0.usd@
            )
            {
                over "SM_table_02_0"
                {
                    over "Section1" (
                        prepend apiSchemas = ["MaterialBindingAPI"]
                    )
                    {
                        rel material:binding = </World/Room/Table/Model/Looks/MI_wood_table_01>
                    }
                }
            }
        }

        def Xform "BackgroundCabinet"
        {

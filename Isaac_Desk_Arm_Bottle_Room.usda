                }

                over "Kitchen_Cabinet001_Door001"
                {
                    bool physics:rigidBodyEnabled = 0

                    over "Kitchen_Cabinet001_Door001"
                    {
                        over "RevoluteJoint" (
                            active = false
                        )
                        {
                        }
                    }

                    over "Collisions"
                    {
                        over "Kitchen_Cabinet001_Door001_C001_Shape"
                        {
                            bool physics:collisionEnabled = 0
                        }

                        over "Kitchen_Cabinet001_Door001_C002_Shape"
                        {
                            bool physics:collisionEnabled = 0
                        }
                    }
                }

                over "Kitchen_Cabinet001_Door002"

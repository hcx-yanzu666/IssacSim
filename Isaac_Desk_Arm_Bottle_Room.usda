            float3 xformOp:scale = (1, 1, 1)
            double3 xformOp:translate = (-0.34999976171070624, 2.0889826228682535, 1.19895339012146)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZ", "xformOp:scale"]

            def "Model" (
                prepend references = @D:/tools/Lightwheel_OpenSource/Lightwheel_OpenSource/Locomotion/KitchenRoom/Kitchen_Cabinet001/Kitchen_Cabinet001.usd@
            )
            {
                over "Kitchen_Cabinet001"

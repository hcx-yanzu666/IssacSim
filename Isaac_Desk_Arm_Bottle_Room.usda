        def RectLight "KeySoftbox"
        {
            color3f inputs:color = (1, 0.94, 0.84)
            float inputs:height = 1.5
            float inputs:intensity = 4500
            float inputs:width = 2
            float xformOp:rotateZ = 0
            float3 xformOp:scale = (1, 1, 1)
            double3 xformOp:translate = (0.2, -0.4, 2.7)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZ", "xformOp:scale"]
        }

        def RectLight "RoomFill"
        {
            color3f inputs:color = (0.86, 0.93, 1)
            float inputs:height = 1.3
            float inputs:intensity = 2500
            float inputs:width = 1.3
            float xformOp:rotateZ = 0
            float3 xformOp:scale = (1, 1, 1)
            double3 xformOp:translate = (-1.4, 1.1, 2.8)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZ", "xformOp:scale"]
        }

        def Camera "OverviewCamera" (
            prepend apiSchemas = ["OmniRtxCameraAutoExposureAPI_1", "OmniRtxCameraExposureAPI_1"]
        )
        {
            float2 clippingRange = (0.03, 100)
            float exposure:fStop = 5
            float exposure:responsivity = 1.1026709
            float exposure:time = 0.02
            float focalLength = 28
            float horizontalAperture = 36
            custom uniform vector3d omni:kit:centerOfInterest = (0, 0, -4.926712900098806)
            matrix4d xformOp:transform = ( (0.5597206704412081, 0.8286813447163196, 1.347663300399482e-16, 0), (-0.21738394253222085, 0.14682879834701718, 0.9649795466770882, 0), (0.7996605483641136, -0.5401189988281508, 0.26232513126820456, 0), (2.4999999999999996, -3.599999999999999, 2.25, 1) )
            uniform token[] xformOpOrder = ["xformOp:transform"]
        }
    }

    over "DeskTop"
    {
        token visibility = "invisible"
    }

    over "DeskLeg_FL"
    {
        token visibility = "invisible"
    }

    over "DeskLeg_FR"
    {
        token visibility = "invisible"
    }

    over "DeskLeg_BL"
    {
        token visibility = "invisible"
    }

    over "DeskLeg_BR"
    {
        token visibility = "invisible"
    }

    over "groundPlane"
    {
        token visibility = "invisible"
    }

    over "AmbientLight"
    {
        float inputs:intensity = 700
    }

    over "DeskLight"
    {
        float inputs:intensity = 600
        float inputs:radius = 0.25
    }

    over "PracticeCube"
    {
        vector3f physics:angularVelocity = (0.026151143, -0.04638589, -0.00009233514)
        vector3f physics:velocity = (-0.00006157545, -0.00005171485, -0.000011484604)
        token visibility = "invisible"
        quatd xformOp:orient = (0.9999998211860657, 5.25893995018123e-7, -2.624543924412137e-7, -0.00048823244287632406)
        double3 xformOp:translate = (0.17998822033405304, -0.000015584038919769228, 0.7749999761581421)
    }
}

over "Render"
{
    over "OmniverseKit"
    {
        over "HydraTextures"
        {
            over "omni_kit_widget_viewport_ViewportTexture_0"
            {
                rel camera = </World/Room/OverviewCamera>
                rel orderedVars = </Render/Vars/LdrColor>
                custom bool overrideClipRange = 0
                uniform int2 resolution = (1280, 720)
            }
        }
    }
}

over "Environment"
{
    over "defaultLight"
    {
        float inputs:intensity = 0
    }
}

